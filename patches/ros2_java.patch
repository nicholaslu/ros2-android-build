@@ -23,6 +23,19 @@ public final class JNIUtils {
 
   private static final String TYPESUPPORT = "rosidl_typesupport_c";
 
+  // Typesupport-implementation-specific JNI libraries. Each contains its own copy of the
+  // generated convert_from_java/convert_to_java functions, whose cached jclass/jmethodID
+  // globals are only initialized in JNI_OnLoad. These libraries are normally pulled in as
+  // ELF dependencies of other JNI libraries or dlopen()ed by the rosidl_typesupport_c
+  // dispatcher, neither of which triggers JNI_OnLoad, so the JVM/ART may bind a native
+  // method to a copy whose globals are still null (crashing with "GetFieldID received
+  // NULL jclass"). Loading them explicitly via System.loadLibrary makes JNI_OnLoad run
+  // for every copy, so any binding is safe.
+  private static final String[] TYPESUPPORT_IMPLEMENTATIONS = {
+    "rosidl_typesupport_fastrtps_c",
+    "rosidl_typesupport_introspection_c",
+  };
+
   /**
    * Private constructor so this cannot be instantiated.
    */
@@ -52,5 +65,14 @@ public final class JNIUtils {
     libraryName = libraryName + "__jni__" + JNIUtils.TYPESUPPORT;
     logger.info("Loading typesupport: " + libraryName);
     System.loadLibrary(libraryName);
+    for (String implementation : TYPESUPPORT_IMPLEMENTATIONS) {
+      String implementationLibraryName =
+          normalizeClassName(cls) + "__jni__" + implementation;
+      try {
+        System.loadLibrary(implementationLibraryName);
+      } catch (UnsatisfiedLinkError e) {
+        logger.info("Typesupport implementation not available: " + implementationLibraryName);
+      }
+    }
   }
 }
