+# Java primitive -> JNI type signature letter. Used to declare sequence and array
+# members of basic type as Java primitive arrays (byte[], double[], ...) rather
+# than boxed java.util.List<T>, so they can be marshalled in bulk instead of one
+# JNI call per element.
+JAVA_PRIMITIVE_TO_JNI_SIGNATURE = {
+    'boolean': 'Z',
+    'byte': 'B',
+    'char': 'C',
+    'short': 'S',
+    'int': 'I',
+    'long': 'J',
+    'float': 'F',
+    'double': 'D',
+}
+
+
+def get_java_primitive(type_):
+    """Java primitive name of a basic type, unwrapping sequences and arrays."""
+    return get_java_type(type_, use_primitives=True)
+
+
+def get_jni_array_type(type_):
+    """JNI array type of a basic type, e.g. 'jbyteArray' for uint8[]."""
+    return 'j%sArray' % get_java_primitive(type_)
+
+
+def get_jni_element_type(type_):
+    """JNI element type of a basic type, e.g. 'jbyte' for uint8[]."""
+    return 'j%s' % get_java_primitive(type_)
+
+
+def get_jni_array_infix(type_):
+    """JNI function infix of a basic type, e.g. 'Byte' in GetByteArrayElements."""
+    return get_java_primitive(type_).capitalize()
+
+
+def get_jni_array_signature(type_):
+    """JNI field signature of a primitive array, e.g. '[B' for uint8[]."""
+    return '[' + JAVA_PRIMITIVE_TO_JNI_SIGNATURE[get_java_primitive(type_)]
+
+
 def get_jni_type(type_):
     return get_java_type(type_, use_primitives=False).replace('.', '/')
 
