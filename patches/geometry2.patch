--- /dev/null
+++ b/tf2_ros_java/src/main/java/org/ros2/tf2_ros/TransformListener.java
@@ -0,0 +1,58 @@
+package org.ros2.tf2_ros;
+
+import java.util.List;
+import org.ros2.rcljava.consumers.Consumer;
+import org.ros2.rcljava.node.Node;
+import tf2_msgs.msg.TFMessage;
+import geometry_msgs.msg.TransformStamped;
+
+public class TransformListener {
+  private static final String DEFAULT_AUTHORITY = "Authority undetectable";
+
+  private final Buffer buffer;
+  private final Node node;
+  private final org.ros2.rcljava.subscription.Subscription<TFMessage> dynamicSubscription;
+  private final org.ros2.rcljava.subscription.Subscription<TFMessage> staticSubscription;
+
+  public TransformListener(final Buffer buffer, final Node node) {
+    this(buffer, node, false);
+  }
+
+  public TransformListener(final Buffer buffer, final Node node, final boolean staticOnly) {
+    this.buffer = buffer;
+    this.node = node;
+
+    if (staticOnly) {
+      this.dynamicSubscription = null;
+    } else {
+      this.dynamicSubscription = node.createSubscription(
+          TFMessage.class, "/tf", new Consumer<TFMessage>() {
+            public void accept(final TFMessage message) {
+              applyTransforms(message.getTransforms(), false);
+            }
+          });
+    }
+
+    this.staticSubscription = node.createSubscription(
+        TFMessage.class, "/tf_static", new Consumer<TFMessage>() {
+          public void accept(final TFMessage message) {
+            applyTransforms(message.getTransforms(), true);
+          }
+        });
+  }
+
+  private void applyTransforms(final List<TransformStamped> transforms, final boolean isStatic) {
+    for (TransformStamped transform : transforms) {
+      this.buffer.getBufferCore().setTransform(transform, DEFAULT_AUTHORITY, isStatic);
+    }
+  }
+
+  public void dispose() {
+    if (this.dynamicSubscription != null) {
+      this.dynamicSubscription.dispose();
+    }
+    if (this.staticSubscription != null) {
+      this.staticSubscription.dispose();
+    }
+  }
+}
