+cmake_minimum_required(VERSION 3.5)
+project(tf2_ros_java)
+
+find_package(ament_cmake REQUIRED)
+find_package(ament_cmake_export_jars REQUIRED)
+find_package(builtin_interfaces REQUIRED)
+find_package(geometry_msgs REQUIRED)
+find_package(rcljava REQUIRED)
+find_package(rcljava_common REQUIRED)
+find_package(tf2_java REQUIRED)
+find_package(tf2_msgs REQUIRED)
+
+find_package(Java COMPONENTS Development REQUIRED)
+enable_language(Java)
+
+include(UseJava)
+
+set(CMAKE_JAVA_COMPILE_FLAGS "-source" "1.6" "-target" "1.6")
+
+# Be explicit about the actual jars we need on javac's classpath.
+set(_tf2_ros_java_include_jars
+  ${builtin_interfaces_JARS}
+  ${geometry_msgs_JARS}
+  ${rcljava_common_JARS}
+  ${rcljava_JARS}
+  ${tf2_java_JARS}
+  ${tf2_msgs_JARS}
+)
+
+message(STATUS "tf2_ros_java jars: ${_tf2_ros_java_include_jars}")
+
+set(${PROJECT_NAME}_sources
+  src/main/java/org/ros2/tf2_ros/Buffer.java
+  src/main/java/org/ros2/tf2_ros/TransformBroadcaster.java
+  src/main/java/org/ros2/tf2_ros/StaticTransformBroadcaster.java
+  src/main/java/org/ros2/tf2_ros/TransformListener.java
+)
+
+add_jar("${PROJECT_NAME}_jar"
+  ${${PROJECT_NAME}_sources}
+  OUTPUT_NAME
+  ${PROJECT_NAME}
+  INCLUDE_JARS
+  ${_tf2_ros_java_include_jars}
+)
+
+install_jar("${PROJECT_NAME}_jar" "share/${PROJECT_NAME}/java")
+ament_export_jars("share/${PROJECT_NAME}/java/${PROJECT_NAME}.jar")
+
+ament_package()
