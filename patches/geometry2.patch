diff --git a/tf2_java/src/main/cpp/org_ros2_tf2_BufferCore.cpp b/tf2_java/src/main/cpp/org_ros2_tf2_BufferCore.cpp
new file mode 100644
index 00000000..6cf6c25f
--- /dev/null
+++ b/tf2_java/src/main/cpp/org_ros2_tf2_BufferCore.cpp
@@ -0,0 +1,380 @@
+#include <jni.h>
+
+#include <chrono>
+#include <string>
+#include <vector>
+
+#include "builtin_interfaces/msg/time.hpp"
+#include "geometry_msgs/msg/transform_stamped.hpp"
+#include "tf2/buffer_core.hpp"
+#include "tf2/exceptions.hpp"
+
+namespace
+{
+
+builtin_interfaces::msg::Time
+to_time_msg(tf2::TimePoint time_point)
+{
+  auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(time_point.time_since_epoch());
+  auto sec = std::chrono::duration_cast<std::chrono::seconds>(ns);
+  ns -= sec;
+
+  builtin_interfaces::msg::Time msg;
+  msg.sec = static_cast<int32_t>(sec.count());
+  msg.nanosec = static_cast<uint32_t>(ns.count());
+  return msg;
+}
+
+tf2::TimePoint
+from_time_msg(const builtin_interfaces::msg::Time & time_msg)
+{
+  auto ns = std::chrono::seconds(time_msg.sec) + std::chrono::nanoseconds(time_msg.nanosec);
+  return tf2::TimePoint(std::chrono::duration_cast<tf2::Duration>(ns));
+}
+
+std::string
+to_string(JNIEnv * env, jstring string)
+{
+  const char * chars = env->GetStringUTFChars(string, nullptr);
+  std::string result(chars == nullptr ? "" : chars);
+  if (chars != nullptr) {
+    env->ReleaseStringUTFChars(string, chars);
+  }
+  return result;
+}
+
+jobject
+new_java_object(JNIEnv * env, const char * class_name)
+{
+  jclass clazz = env->FindClass(class_name);
+  jmethodID constructor = env->GetMethodID(clazz, "<init>", "()V");
+  return env->NewObject(clazz, constructor);
+}
+
+builtin_interfaces::msg::Time
+from_java_time(JNIEnv * env, jobject jtime)
+{
+  jclass time_class = env->GetObjectClass(jtime);
+  jmethodID get_sec = env->GetMethodID(time_class, "getSec", "()I");
+  jmethodID get_nanosec = env->GetMethodID(time_class, "getNanosec", "()I");
+
+  builtin_interfaces::msg::Time time_msg;
+  time_msg.sec = static_cast<int32_t>(env->CallIntMethod(jtime, get_sec));
+  time_msg.nanosec = static_cast<uint32_t>(env->CallIntMethod(jtime, get_nanosec));
+  return time_msg;
+}
+
+jobject
+to_java_time(JNIEnv * env, const builtin_interfaces::msg::Time & time_msg)
+{
+  jobject jtime = new_java_object(env, "builtin_interfaces/msg/Time");
+  jclass time_class = env->GetObjectClass(jtime);
+  jmethodID set_sec = env->GetMethodID(time_class, "setSec", "(I)Lbuiltin_interfaces/msg/Time;");
+  jmethodID set_nanosec =
+    env->GetMethodID(time_class, "setNanosec", "(I)Lbuiltin_interfaces/msg/Time;");
+  env->CallObjectMethod(jtime, set_sec, static_cast<jint>(time_msg.sec));
+  env->CallObjectMethod(jtime, set_nanosec, static_cast<jint>(time_msg.nanosec));
+  return jtime;
+}
+
+geometry_msgs::msg::TransformStamped
+from_java_transform_stamped(JNIEnv * env, jobject jtransform_stamped)
+{
+  geometry_msgs::msg::TransformStamped transform_stamped;
+
+  jclass transform_stamped_class = env->GetObjectClass(jtransform_stamped);
+  jmethodID get_header =
+    env->GetMethodID(transform_stamped_class, "getHeader", "()Lstd_msgs/msg/Header;");
+  jmethodID get_child_frame_id =
+    env->GetMethodID(transform_stamped_class, "getChildFrameId", "()Ljava/lang/String;");
+  jmethodID get_transform = env->GetMethodID(
+    transform_stamped_class, "getTransform", "()Lgeometry_msgs/msg/Transform;");
+
+  jobject jheader = env->CallObjectMethod(jtransform_stamped, get_header);
+  jobject jtransform = env->CallObjectMethod(jtransform_stamped, get_transform);
+  jstring jchild_frame_id =
+    static_cast<jstring>(env->CallObjectMethod(jtransform_stamped, get_child_frame_id));
+
+  jclass header_class = env->GetObjectClass(jheader);
+  jmethodID get_stamp =
+    env->GetMethodID(header_class, "getStamp", "()Lbuiltin_interfaces/msg/Time;");
+  jmethodID get_frame_id = env->GetMethodID(header_class, "getFrameId", "()Ljava/lang/String;");
+
+  jobject jstamp = env->CallObjectMethod(jheader, get_stamp);
+  jstring jframe_id = static_cast<jstring>(env->CallObjectMethod(jheader, get_frame_id));
+
+  transform_stamped.header.stamp = from_java_time(env, jstamp);
+  transform_stamped.header.frame_id = to_string(env, jframe_id);
+  transform_stamped.child_frame_id = to_string(env, jchild_frame_id);
+
+  jclass transform_class = env->GetObjectClass(jtransform);
+  jmethodID get_translation = env->GetMethodID(
+    transform_class, "getTranslation", "()Lgeometry_msgs/msg/Vector3;");
+  jmethodID get_rotation = env->GetMethodID(
+    transform_class, "getRotation", "()Lgeometry_msgs/msg/Quaternion;");
+
+  jobject jtranslation = env->CallObjectMethod(jtransform, get_translation);
+  jobject jrotation = env->CallObjectMethod(jtransform, get_rotation);
+
+  jclass vector3_class = env->GetObjectClass(jtranslation);
+  jmethodID get_x = env->GetMethodID(vector3_class, "getX", "()D");
+  jmethodID get_y = env->GetMethodID(vector3_class, "getY", "()D");
+  jmethodID get_z = env->GetMethodID(vector3_class, "getZ", "()D");
+
+  transform_stamped.transform.translation.x = env->CallDoubleMethod(jtranslation, get_x);
+  transform_stamped.transform.translation.y = env->CallDoubleMethod(jtranslation, get_y);
+  transform_stamped.transform.translation.z = env->CallDoubleMethod(jtranslation, get_z);
+
+  jclass quaternion_class = env->GetObjectClass(jrotation);
+  transform_stamped.transform.rotation.x = env->CallDoubleMethod(jrotation, get_x);
+  transform_stamped.transform.rotation.y = env->CallDoubleMethod(jrotation, get_y);
+  transform_stamped.transform.rotation.z = env->CallDoubleMethod(jrotation, get_z);
+  jmethodID get_w = env->GetMethodID(quaternion_class, "getW", "()D");
+  transform_stamped.transform.rotation.w = env->CallDoubleMethod(jrotation, get_w);
+
+  return transform_stamped;
+}
+
+jobject
+to_java_transform_stamped(JNIEnv * env, const geometry_msgs::msg::TransformStamped & transform)
+{
+  jobject jtransform_stamped = new_java_object(env, "geometry_msgs/msg/TransformStamped");
+  jclass transform_stamped_class = env->GetObjectClass(jtransform_stamped);
+  jmethodID set_header = env->GetMethodID(
+    transform_stamped_class, "setHeader", "(Lstd_msgs/msg/Header;)Lgeometry_msgs/msg/TransformStamped;");
+  jmethodID set_child_frame_id = env->GetMethodID(
+    transform_stamped_class, "setChildFrameId",
+    "(Ljava/lang/String;)Lgeometry_msgs/msg/TransformStamped;");
+  jmethodID set_transform = env->GetMethodID(
+    transform_stamped_class, "setTransform",
+    "(Lgeometry_msgs/msg/Transform;)Lgeometry_msgs/msg/TransformStamped;");
+
+  jobject jheader = new_java_object(env, "std_msgs/msg/Header");
+  jclass header_class = env->GetObjectClass(jheader);
+  jmethodID set_stamp =
+    env->GetMethodID(header_class, "setStamp", "(Lbuiltin_interfaces/msg/Time;)Lstd_msgs/msg/Header;");
+  jmethodID set_frame_id =
+    env->GetMethodID(header_class, "setFrameId", "(Ljava/lang/String;)Lstd_msgs/msg/Header;");
+  env->CallObjectMethod(jheader, set_stamp, to_java_time(env, transform.header.stamp));
+  env->CallObjectMethod(
+    jheader, set_frame_id, env->NewStringUTF(transform.header.frame_id.c_str()));
+
+  jobject jnative_transform = new_java_object(env, "geometry_msgs/msg/Transform");
+  jclass native_transform_class = env->GetObjectClass(jnative_transform);
+  jmethodID set_translation = env->GetMethodID(
+    native_transform_class, "setTranslation",
+    "(Lgeometry_msgs/msg/Vector3;)Lgeometry_msgs/msg/Transform;");
+  jmethodID set_rotation = env->GetMethodID(
+    native_transform_class, "setRotation",
+    "(Lgeometry_msgs/msg/Quaternion;)Lgeometry_msgs/msg/Transform;");
+
+  jobject jtranslation = new_java_object(env, "geometry_msgs/msg/Vector3");
+  jclass vector3_class = env->GetObjectClass(jtranslation);
+  jmethodID set_x = env->GetMethodID(
+    vector3_class, "setX", "(D)Lgeometry_msgs/msg/Vector3;");
+  jmethodID set_y = env->GetMethodID(
+    vector3_class, "setY", "(D)Lgeometry_msgs/msg/Vector3;");
+  jmethodID set_z = env->GetMethodID(
+    vector3_class, "setZ", "(D)Lgeometry_msgs/msg/Vector3;");
+  env->CallObjectMethod(jtranslation, set_x, transform.transform.translation.x);
+  env->CallObjectMethod(jtranslation, set_y, transform.transform.translation.y);
+  env->CallObjectMethod(jtranslation, set_z, transform.transform.translation.z);
+
+  jobject jrotation = new_java_object(env, "geometry_msgs/msg/Quaternion");
+  jclass quaternion_class = env->GetObjectClass(jrotation);
+  env->CallObjectMethod(jrotation, set_x, transform.transform.rotation.x);
+  env->CallObjectMethod(jrotation, set_y, transform.transform.rotation.y);
+  env->CallObjectMethod(jrotation, set_z, transform.transform.rotation.z);
+  jmethodID set_w = env->GetMethodID(
+    quaternion_class, "setW", "(D)Lgeometry_msgs/msg/Quaternion;");
+  env->CallObjectMethod(jrotation, set_w, transform.transform.rotation.w);
+
+  env->CallObjectMethod(jnative_transform, set_translation, jtranslation);
+  env->CallObjectMethod(jnative_transform, set_rotation, jrotation);
+
+  env->CallObjectMethod(jtransform_stamped, set_header, jheader);
+  env->CallObjectMethod(
+    jtransform_stamped, set_child_frame_id, env->NewStringUTF(transform.child_frame_id.c_str()));
+  env->CallObjectMethod(jtransform_stamped, set_transform, jnative_transform);
+  return jtransform_stamped;
+}
+
+void
+throw_tf2_exception(JNIEnv * env, const char * class_name, const std::string & message)
+{
+  jclass exception_class = env->FindClass(class_name);
+  env->ThrowNew(exception_class, message.c_str());
+}
+
+void
+translate_exception(JNIEnv * env, const tf2::TransformException & exception)
+{
+  if (dynamic_cast<const tf2::ConnectivityException *>(&exception) != nullptr) {
+    throw_tf2_exception(env, "org/ros2/tf2/TF2ConnectivityException", exception.what());
+    return;
+  }
+  if (dynamic_cast<const tf2::LookupException *>(&exception) != nullptr) {
+    throw_tf2_exception(env, "org/ros2/tf2/TF2LookupException", exception.what());
+    return;
+  }
+  if (dynamic_cast<const tf2::ExtrapolationException *>(&exception) != nullptr) {
+    throw_tf2_exception(env, "org/ros2/tf2/TF2ExtrapolationException", exception.what());
+    return;
+  }
+  if (dynamic_cast<const tf2::InvalidArgumentException *>(&exception) != nullptr) {
+    throw_tf2_exception(env, "org/ros2/tf2/TF2InvalidArgumentException", exception.what());
+    return;
+  }
+  if (dynamic_cast<const tf2::TimeoutException *>(&exception) != nullptr) {
+    throw_tf2_exception(env, "org/ros2/tf2/TF2TimeoutException", exception.what());
+    return;
+  }
+  throw_tf2_exception(env, "org/ros2/tf2/TF2Exception", exception.what());
+}
+
+}  // namespace
+
+extern "C"
+{
+
+JNIEXPORT jlong JNICALL
+Java_org_ros2_tf2_BufferCore_nativeCreateBufferCore(JNIEnv *, jclass, jlong cache_time_nanos)
+{
+  auto cache_time = tf2::Duration(std::chrono::nanoseconds(cache_time_nanos));
+  auto * buffer_core = new tf2::BufferCore(cache_time);
+  return reinterpret_cast<jlong>(buffer_core);
+}
+
+JNIEXPORT void JNICALL
+Java_org_ros2_tf2_BufferCore_nativeDispose(JNIEnv *, jclass, jlong handle)
+{
+  if (handle == 0) {
+    return;
+  }
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  delete buffer_core;
+}
+
+JNIEXPORT void JNICALL
+Java_org_ros2_tf2_BufferCore_nativeClear(JNIEnv *, jclass, jlong handle)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  buffer_core->clear();
+}
+
+JNIEXPORT void JNICALL
+Java_org_ros2_tf2_BufferCore_nativeSetTransform(
+  JNIEnv * env, jclass, jlong handle, jobject jtransform, jstring jauthority, jboolean is_static)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  auto transform = from_java_transform_stamped(env, jtransform);
+  auto authority = to_string(env, jauthority);
+  try {
+    buffer_core->setTransform(transform, authority, is_static);
+  } catch (const tf2::TransformException & exception) {
+    translate_exception(env, exception);
+  }
+}
+
+JNIEXPORT jobject JNICALL
+Java_org_ros2_tf2_BufferCore_nativeLookupTransform(
+  JNIEnv * env, jclass, jlong handle, jstring jtarget_frame, jstring jsource_frame, jobject jtime)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  auto target_frame = to_string(env, jtarget_frame);
+  auto source_frame = to_string(env, jsource_frame);
+  auto time = from_time_msg(from_java_time(env, jtime));
+  try {
+    auto transform = buffer_core->lookupTransform(target_frame, source_frame, time);
+    return to_java_transform_stamped(env, transform);
+  } catch (const tf2::TransformException & exception) {
+    translate_exception(env, exception);
+    return nullptr;
+  }
+}
+
+JNIEXPORT jobject JNICALL
+Java_org_ros2_tf2_BufferCore_nativeLookupTransformFull(
+  JNIEnv * env, jclass, jlong handle, jstring jtarget_frame, jobject jtarget_time,
+  jstring jsource_frame, jobject jsource_time, jstring jfixed_frame)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  auto target_frame = to_string(env, jtarget_frame);
+  auto source_frame = to_string(env, jsource_frame);
+  auto fixed_frame = to_string(env, jfixed_frame);
+  auto target_time = from_time_msg(from_java_time(env, jtarget_time));
+  auto source_time = from_time_msg(from_java_time(env, jsource_time));
+  try {
+    auto transform = buffer_core->lookupTransform(
+      target_frame, target_time, source_frame, source_time, fixed_frame);
+    return to_java_transform_stamped(env, transform);
+  } catch (const tf2::TransformException & exception) {
+    translate_exception(env, exception);
+    return nullptr;
+  }
+}
+
+JNIEXPORT jboolean JNICALL
+Java_org_ros2_tf2_BufferCore_nativeCanTransform(
+  JNIEnv * env, jclass, jlong handle, jstring jtarget_frame, jstring jsource_frame, jobject jtime)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  auto target_frame = to_string(env, jtarget_frame);
+  auto source_frame = to_string(env, jsource_frame);
+  auto time = from_time_msg(from_java_time(env, jtime));
+  try {
+    return buffer_core->canTransform(target_frame, source_frame, time);
+  } catch (const tf2::TransformException & exception) {
+    translate_exception(env, exception);
+    return false;
+  }
+}
+
+JNIEXPORT jboolean JNICALL
+Java_org_ros2_tf2_BufferCore_nativeCanTransformFull(
+  JNIEnv * env, jclass, jlong handle, jstring jtarget_frame, jobject jtarget_time,
+  jstring jsource_frame, jobject jsource_time, jstring jfixed_frame)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  auto target_frame = to_string(env, jtarget_frame);
+  auto source_frame = to_string(env, jsource_frame);
+  auto fixed_frame = to_string(env, jfixed_frame);
+  auto target_time = from_time_msg(from_java_time(env, jtarget_time));
+  auto source_time = from_time_msg(from_java_time(env, jsource_time));
+  try {
+    return buffer_core->canTransform(
+      target_frame, target_time, source_frame, source_time, fixed_frame);
+  } catch (const tf2::TransformException & exception) {
+    translate_exception(env, exception);
+    return false;
+  }
+}
+
+JNIEXPORT jstring JNICALL
+Java_org_ros2_tf2_BufferCore_nativeAllFramesAsYAML(JNIEnv * env, jclass, jlong handle)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  return env->NewStringUTF(buffer_core->allFramesAsYAML().c_str());
+}
+
+JNIEXPORT jstring JNICALL
+Java_org_ros2_tf2_BufferCore_nativeAllFramesAsString(JNIEnv * env, jclass, jlong handle)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  return env->NewStringUTF(buffer_core->allFramesAsString().c_str());
+}
+
+JNIEXPORT jobjectArray JNICALL
+Java_org_ros2_tf2_BufferCore_nativeGetAllFrameNames(JNIEnv * env, jclass, jlong handle)
+{
+  auto * buffer_core = reinterpret_cast<tf2::BufferCore *>(handle);
+  std::vector<std::string> frame_names = buffer_core->getAllFrameNames();
+  jclass string_class = env->FindClass("java/lang/String");
+  jobjectArray result = env->NewObjectArray(frame_names.size(), string_class, nullptr);
+  for (jsize i = 0; i < static_cast<jsize>(frame_names.size()); ++i) {
+    env->SetObjectArrayElement(result, i, env->NewStringUTF(frame_names[i].c_str()));
+  }
+  return result;
+}
