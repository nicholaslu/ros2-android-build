+
+public class Buffer {
+  private final BufferCore bufferCore;
+
+  public Buffer() {
+    this(new BufferCore());
+  }
+
+  public Buffer(final BufferCore bufferCore) {
+    this.bufferCore = bufferCore;
+  }
+
+  public BufferCore getBufferCore() {
+    return this.bufferCore;
+  }
+
+  public void clear() {
+    this.bufferCore.clear();
+  }
+
+  public void setTransform(final TransformStamped transform, final String authority) {
+    this.bufferCore.setTransform(transform, authority, false);
+  }
+
+  public void setTransformStatic(final TransformStamped transform, final String authority) {
+    this.bufferCore.setTransform(transform, authority, true);
+  }
+
+  public TransformStamped lookupTransform(
+      final String targetFrame, final String sourceFrame, final Time time) {
+    return this.bufferCore.lookupTransform(targetFrame, sourceFrame, time);
+  }
+
+  public TransformStamped lookupTransform(
+      final String targetFrame,
+      final Time targetTime,
+      final String sourceFrame,
+      final Time sourceTime,
+      final String fixedFrame) {
+    return this.bufferCore.lookupTransform(
+        targetFrame, targetTime, sourceFrame, sourceTime, fixedFrame);
+  }
+
+  public boolean canTransform(final String targetFrame, final String sourceFrame, final Time time) {
+    return this.bufferCore.canTransform(targetFrame, sourceFrame, time);
+  }
+
+  public boolean canTransform(
+      final String targetFrame,
+      final Time targetTime,
+      final String sourceFrame,
+      final Time sourceTime,
+      final String fixedFrame) {
+    return this.bufferCore.canTransform(
+        targetFrame, targetTime, sourceFrame, sourceTime, fixedFrame);
+  }
+
+  public String allFramesAsYAML() {
+    return this.bufferCore.allFramesAsYAML();
+  }
+
+  public String allFramesAsString() {
+    return this.bufferCore.allFramesAsString();
+  }
+
+  public String[] getAllFrameNames() {
+    return this.bufferCore.getAllFrameNames();
+  }
+}
