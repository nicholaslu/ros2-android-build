diff --git a/tf2_java/CMakeLists.txt b/tf2_java/CMakeLists.txt
new file mode 100644
index 00000000..2e09baf6
--- /dev/null
+++ b/tf2_java/CMakeLists.txt
@@ -0,0 +1,118 @@
+cmake_minimum_required(VERSION 3.5)
+project(tf2_java)
+
+find_package(ament_cmake REQUIRED)
+find_package(ament_cmake_export_jars REQUIRED)
+find_package(ament_cmake_export_jni_libraries REQUIRED)
+find_package(builtin_interfaces REQUIRED)
+find_package(geometry_msgs REQUIRED)
+find_package(rcljava_common REQUIRED)
+find_package(std_msgs REQUIRED)
+find_package(tf2 REQUIRED)
+
+include(CrossCompilingExtra)
+
+if(CMAKE_CROSSCOMPILING)
+  find_host_package(Java COMPONENTS Development REQUIRED)
+else()
+  find_package(Java COMPONENTS Development REQUIRED)
+endif()
+if(NOT ANDROID)
+  find_package(JNI REQUIRED)
+endif()
+include(UseJava)
+include(JavaExtra)
+
+if(NOT CMAKE_CXX_STANDARD)
+  set(CMAKE_CXX_STANDARD 14)
+endif()
+
+if(NOT WIN32)
+  add_compile_options(-Wall -Wextra -Wpedantic)
+endif()
+
+set(CMAKE_JAVA_COMPILE_FLAGS "-source" "1.6" "-target" "1.6")
+
+set(_jni_target org_ros2_tf2_buffer_core)
+add_library(${_jni_target} SHARED
+  src/main/cpp/org_ros2_tf2_BufferCore.cpp
+)
+if(WIN32)
+  set_target_properties(${_jni_target} PROPERTIES
+    PREFIX ""
+    OUTPUT_NAME "${_jni_target}__jni"
+  )
+else()
+  set_target_properties(${_jni_target} PROPERTIES
+    PREFIX "lib"
+    OUTPUT_NAME "${_jni_target}__jni"
+  )
+endif()
+
+target_include_directories(${_jni_target}
+  PUBLIC
+  ${JNI_INCLUDE_DIRS}
+)
+
+# ament_target_dependencies() was removed in Lyrical (ament_cmake 2.x), but the
+# per-package <pkg>_INCLUDE_DIRS / <pkg>_LIBRARIES / <pkg>_DEFINITIONS variables it
+# consumed are still exported by the ament_cmake_export_* extras. Apply them directly.
+if(NOT COMMAND _tf2_java_target_dependencies)
+  function(_tf2_java_target_dependencies _target)
+    foreach(_pkg ${ARGN})
+      if(NOT ${_pkg}_FOUND)
+        find_package(${_pkg} QUIET REQUIRED)
+      endif()
+      if(${_pkg}_INCLUDE_DIRS)
+        target_include_directories(${_target} PUBLIC ${${_pkg}_INCLUDE_DIRS})
+      endif()
+      if(${_pkg}_LIBRARIES)
+        target_link_libraries(${_target} ${${_pkg}_LIBRARIES})
+      endif()
+      if(${_pkg}_DEFINITIONS)
+        target_compile_definitions(${_target} PUBLIC ${${_pkg}_DEFINITIONS})
+      endif()
+    endforeach()
+  endfunction()
+endif()
+
+_tf2_java_target_dependencies(${_jni_target}
+  builtin_interfaces
+  geometry_msgs
+  rcljava_common
+  std_msgs
+  tf2
+)
+
+ament_export_jni_libraries(${_jni_target})
+
+install(TARGETS ${_jni_target}
+  ARCHIVE DESTINATION lib/jni
+  LIBRARY DESTINATION lib/jni
+)
+
+set(${PROJECT_NAME}_sources
+  src/main/java/org/ros2/tf2/BufferCore.java
+  src/main/java/org/ros2/tf2/TF2Exception.java
+  src/main/java/org/ros2/tf2/TF2ConnectivityException.java
+  src/main/java/org/ros2/tf2/TF2ExtrapolationException.java
+  src/main/java/org/ros2/tf2/TF2InvalidArgumentException.java
+  src/main/java/org/ros2/tf2/TF2LookupException.java
+  src/main/java/org/ros2/tf2/TF2TimeoutException.java
+)
+
+add_jar("${PROJECT_NAME}_jar"
+  ${${PROJECT_NAME}_sources}
+  OUTPUT_NAME
+  ${PROJECT_NAME}
+  INCLUDE_JARS
+  ${builtin_interfaces_JARS}
+  ${geometry_msgs_JARS}
+  ${rcljava_common_JARS}
+  ${std_msgs_JARS}
+)
+
+install_jar("${PROJECT_NAME}_jar" "share/${PROJECT_NAME}/java")
+ament_export_jars("share/${PROJECT_NAME}/java/${PROJECT_NAME}.jar")
+
+ament_package()
