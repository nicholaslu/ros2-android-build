@@ -0,0 +1,40 @@
+package org.ros2.tf2_ros;
+
+import geometry_msgs.msg.TransformStamped;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.ros2.rcljava.node.Node;
+import org.ros2.rcljava.publisher.Publisher;
+import tf2_msgs.msg.TFMessage;
+
+public class StaticTransformBroadcaster {
+  private final Publisher<TFMessage> publisher;
+  private final Map<String, TransformStamped> netMessageTransforms;
+
+  public StaticTransformBroadcaster(final Node node) {
+    this.publisher = node.createPublisher(TFMessage.class, "/tf_static");
+    this.netMessageTransforms = new LinkedHashMap<String, TransformStamped>();
+  }
+
+  public void sendTransform(final TransformStamped transform) {
+    ArrayList<TransformStamped> transforms = new ArrayList<TransformStamped>();
+    transforms.add(transform);
+    sendTransform(transforms);
+  }
+
+  public void sendTransform(final List<TransformStamped> transforms) {
+    for (TransformStamped transform : transforms) {
+      this.netMessageTransforms.put(transform.getChildFrameId(), transform);
+    }
+
+    TFMessage message = new TFMessage();
+    message.setTransforms(new ArrayList<TransformStamped>(this.netMessageTransforms.values()));
+    this.publisher.publish(message);
+  }
+
+  public void dispose() {
+    this.publisher.dispose();
+  }
+}
