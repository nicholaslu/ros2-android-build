diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4f81148..41a4b60 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,7 @@
 
-cmake_minimum_required(VERSION 3.0)
+# CMake 4 refuses cmake_minimum_required below 3.5. libyaml_vendor passed
+# -DCMAKE_POLICY_VERSION_MINIMUM=3.5 for this when it still vendored libyaml.
+cmake_minimum_required(VERSION 3.5)
 project (yaml C)
 
 set (YAML_VERSION_MAJOR 0)
@@ -7,7 +9,10 @@ set (YAML_VERSION_MINOR 2)
 set (YAML_VERSION_PATCH 5)
 set (YAML_VERSION_STRING "${YAML_VERSION_MAJOR}.${YAML_VERSION_MINOR}.${YAML_VERSION_PATCH}")
 
-option(BUILD_SHARED_LIBS "Build libyaml as a shared library" OFF)
+# Shared by default: this package stands in for Ubuntu's libyaml-dev, which
+# ships libyaml as a shared library, and rcl and rcl_yaml_param_parser both
+# link it. Static would put a separate copy of libyaml into each.
+option(BUILD_SHARED_LIBS "Build libyaml as a shared library" ON)
 set(YAML_STATIC_LIB_NAME "yaml" CACHE STRING "Base name of static library output")
 
