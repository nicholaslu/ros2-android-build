   )
 endmacro(INSTALL_ZENOH)
 
-INSTALL_ZENOH(${RUST_TARGET_DIR}/release/zenoh-bridge-ros2dds lib/${PROJECT_NAME})
+INSTALL_ZENOH(${RUST_BINARY} lib/${PROJECT_NAME})
 
-INSTALL_ZENOH(${RUST_TARGET_DIR}/release/zenoh-bridge-ros2dds bin)
+INSTALL_ZENOH(${RUST_BINARY} bin)
+
+if(ANDROID)
+  # An Android app may only exec binaries from its nativeLibraryDir, and the
+  # installer only extracts files named lib*.so there. Install it under that name
+  # too, so it can ship in jniLibs like a library.
+  install(FILES
+    ${RUST_BINARY}
+    RENAME libzenoh_bridge_ros2dds.so
+    PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE
+    DESTINATION lib
+  )
+endif()
 
