diff --git a/CMakeLists.txt b/CMakeLists.txt
index 419b639..fc1c15b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -33,18 +33,71 @@ FILE(GLOB RUST_SRC_FILES
   ${CMAKE_SOURCE_DIR}/zenoh-plugin-ros2dds/src/*.rs
   ${CMAKE_SOURCE_DIR}/Cargo.lock)
 
+if(ANDROID)
+  # Cross-compile with the NDK. The image already provides cargo's linker and the
+  # cc crate's CC_/CXX_/AR_ variables for the target; what is set here covers
+  # cyclors, which builds Cyclone DDS through the cmake crate and runs bindgen, and
+  # one image-wide cargo setting that must not reach this binary.
+  if(ANDROID_ABI STREQUAL "arm64-v8a")
+    set(RUST_TARGET aarch64-linux-android)
+  else()
+    message(FATAL_ERROR "zenoh_bridge_ros2dds: unsupported ANDROID_ABI '${ANDROID_ABI}'")
+  endif()
+  string(REPLACE "-" "_" RUST_TARGET_ENV "${RUST_TARGET}")
+  foreach(_var ANDROID_TOOLCHAIN_ROOT ANDROID_PLATFORM ANDROID_PLATFORM_LEVEL CMAKE_SYSROOT)
+    if(NOT ${_var})
+      message(FATAL_ERROR "zenoh_bridge_ros2dds: ${_var} is not set by the NDK toolchain")
+    endif()
+  endforeach()
+
+  # The cmake crate hands Cyclone the NDK toolchain without ANDROID_ABI or
+  # ANDROID_PLATFORM, so the NDK falls back to armeabi-v7a at API 21. Pin both to
+  # this build's values, then defer to the same NDK toolchain.
+  set(CARGO_CMAKE_TOOLCHAIN "${CMAKE_BINARY_DIR}/cargo-android.toolchain.cmake")
+  file(WRITE "${CARGO_CMAKE_TOOLCHAIN}"
+    "set(ANDROID_ABI ${ANDROID_ABI})\n"
+    "set(ANDROID_PLATFORM ${ANDROID_PLATFORM})\n"
+    "include(\"${CMAKE_TOOLCHAIN_FILE}\")\n")
+
+  # bindgen needs libclang; the NDK ships one. libclang derives its resource dir
+  # (stddef.h, ...) from the host process -- cargo's build script -- rather than
+  # from the NDK clang, so pass it explicitly with the sysroot and API level.
+  execute_process(
+    COMMAND "${ANDROID_TOOLCHAIN_ROOT}/bin/clang" -print-resource-dir
+    OUTPUT_VARIABLE NDK_CLANG_RESOURCE_DIR
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    COMMAND_ERROR_IS_FATAL ANY)
+
+  set(CARGO_ENV
+    "LIBCLANG_PATH=${ANDROID_TOOLCHAIN_ROOT}/lib"
+    "BINDGEN_EXTRA_CLANG_ARGS_${RUST_TARGET_ENV}=--target=${RUST_TARGET}${ANDROID_PLATFORM_LEVEL} --sysroot=${CMAKE_SYSROOT} -resource-dir=${NDK_CLANG_RESOURCE_DIR}"
+    "CMAKE_TOOLCHAIN_FILE_${RUST_TARGET_ENV}=${CARGO_CMAKE_TOOLCHAIN}"
+    # The image's cargo config forces -soname,libzenohc.so onto every artifact
+    # for this target, which zenoh-c needs. An empty RUSTFLAGS takes precedence.
+    "RUSTFLAGS=")
+  set(CARGO_TARGET_ARGS --target ${RUST_TARGET})
+  set(RUST_BINARY "${RUST_TARGET_DIR}/${RUST_TARGET}/release/zenoh-bridge-ros2dds")
+else()
+  set(CARGO_ENV "")
+  set(CARGO_TARGET_ARGS "")
+  set(RUST_BINARY "${RUST_TARGET_DIR}/release/zenoh-bridge-ros2dds")
+endif()
+
+# --locked: build exactly the dependency versions in Cargo.lock.
 add_custom_command(
   OUTPUT
-  ${RUST_TARGET_DIR}/release/zenoh-bridge-ros2dds
-  COMMAND cargo build --release --manifest-path "${CMAKE_SOURCE_DIR}/zenoh-bridge-ros2dds/Cargo.toml" --target-dir "${RUST_TARGET_DIR}"
+  ${RUST_BINARY}
+  COMMAND ${CMAKE_COMMAND} -E env ${CARGO_ENV}
+    cargo build --release --locked ${CARGO_TARGET_ARGS} --manifest-path "${CMAKE_SOURCE_DIR}/zenoh-bridge-ros2dds/Cargo.toml" --target-dir "${RUST_TARGET_DIR}"
   DEPENDS
   ${RUST_SRC_FILES}
+  VERBATIM
 )
 
 add_custom_target(
   build_crate ALL
   DEPENDS
-  ${RUST_TARGET_DIR}/release/zenoh-bridge-ros2dds
+  ${RUST_BINARY}
 )
 
