diff --git a/orocos_kdl_vendor/CMakeLists.txt b/orocos_kdl_vendor/CMakeLists.txt
index 0f60293..558b89a 100644
--- a/orocos_kdl_vendor/CMakeLists.txt
+++ b/orocos_kdl_vendor/CMakeLists.txt
@@ -13,6 +13,17 @@ if(NOT CMAKE_CXX_STANDARD)
   set(CMAKE_CXX_STANDARD_REQUIRED ON)
 endif()
 
+# ament_vendor() forwards CMAKE_TOOLCHAIN_FILE and the ANDROID_* variables to the
+# sub-build, but not Eigen's location, so the cross-compiled orocos_kdl fails with
+# EIGEN3_INCLUDE_DIR-NOTFOUND. Forward it explicitly when the outer build set it.
+set(_vendor_eigen_args)
+if(DEFINED EIGEN3_INCLUDE_DIR)
+  list(APPEND _vendor_eigen_args "-DEIGEN3_INCLUDE_DIR=${EIGEN3_INCLUDE_DIR}")
+endif()
+if(DEFINED Eigen3_DIR)
+  list(APPEND _vendor_eigen_args "-DEigen3_DIR=${Eigen3_DIR}")
+endif()
+
 ament_vendor(orocos_kdl_vendor
   SATISFIED ${orocos_kdl_FOUND}
   VCS_URL https://github.com/orocos/orocos_kinematics_dynamics.git
@@ -24,6 +35,7 @@ ament_vendor(orocos_kdl_vendor
     -DENABLE_TESTS:BOOL=OFF
     -DENABLE_EXAMPLES:BOOL=OFF
     -DCMAKE_POLICY_VERSION_MINIMUM=3.5
+    ${_vendor_eigen_args}
   PATCHES patches
 )
 
