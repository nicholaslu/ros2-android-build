diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8ecc35a..e9f4634 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -5,6 +5,11 @@ project(kdl_parser)
 find_package(ament_cmake_ros REQUIRED)
 find_package(eigen3_cmake_module REQUIRED)
 find_package(Eigen3 REQUIRED)
+# Lyrical's kdl_parser expects orocos_kdl from the system (liborocos-kdl-dev via
+# rosdep), which does not exist for an Android cross build. We still vendor it,
+# so pull in the vendor package first -- its -extras.cmake registers the
+# vendored prefix that makes find_package(orocos_kdl) below succeed.
+find_package(orocos_kdl_vendor REQUIRED)
 find_package(orocos_kdl REQUIRED)
 find_package(urdf REQUIRED)
 find_package(urdfdom_headers REQUIRED)
